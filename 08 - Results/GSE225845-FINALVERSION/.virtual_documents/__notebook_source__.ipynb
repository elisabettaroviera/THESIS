                   c=[col], s=22, alpha=0.75, label=lbl, zorder=2)

    ax.set_xlabel(rf"PC1 ({ve[0]*100:.1f}\%)")
    ax.set_ylabel(rf"PC2 ({ve[1]*100:.1f}\%)")
    ax.set_title(title, fontsize=10)
    place_legend(ax)

